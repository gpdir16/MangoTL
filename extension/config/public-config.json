{
    "defaults": { "sourceLanguage": "ja", "targetLanguage": "ko" },
    "languages": {
        "sources": [
            { "code": "ja", "label": "Japanese" },
            { "code": "ko", "label": "Korean" },
            { "code": "en", "label": "English" },
            { "code": "zh", "label": "Chinese" },
            { "code": "de", "label": "German" },
            { "code": "sv", "label": "Swedish" }
        ],
        "targets": [
            { "code": "ja", "label": "Japanese" },
            { "code": "ko", "label": "Korean" },
            { "code": "en", "label": "English" },
            { "code": "zh", "label": "Chinese" },
            { "code": "de", "label": "German" },
            { "code": "sv", "label": "Swedish" }
        ]
    },
    "websites": [
        {
            "id": "pixiv",
            "name": "Pixiv",
            "sourceLanguage": "ja",
            "hostPatterns": ["pixiv.net", "*.pixiv.net"],
            "imageHostPatterns": ["i.pximg.net", "*.pximg.net"],
            "imageSelectors": ["main img[src*='pximg.net']", "article img[src*='pximg.net']", "img[src*='i.pximg.net']"],
            "imageFetch": { "referrer": "https://www.pixiv.net/", "referrerPolicy": "no-referrer-when-downgrade" },
            "includeUrlPatterns": ["/img-original/", "/img-master/"],
            "excludeUrlPatterns": ["/custom-thumb/", "/c/", "/soy/", "/common/", "/static/"],
            "minImageWidth": 300,
            "minImageHeight": 300,
            "urlNormalizer": { "stripHash": true, "stripQuery": true },
            "imageKeyPattern": {
                "match": "/img-[^/]+/img/(.+?)(?:_master1200|_square1200|_custom1200)?\\.(?:jpg|jpeg|png|webp)$",
                "group": 1,
                "flags": "i"
            }
        },
        {
            "id": "x",
            "name": "X",
            "sourceLanguage": "en",
            "hostPatterns": ["x.com", "*.x.com"],
            "imageHostPatterns": ["pbs.twimg.com", "*.pbs.twimg.com"],
            "imageSelectors": ["img[src*='pbs.twimg.com']", "img[src*='twimg.com']"],
            "imageFetch": { "referrer": "https://x.com/", "referrerPolicy": "no-referrer-when-downgrade" },
            "includeUrlPatterns": ["/media/"],
            "excludeUrlPatterns": [],
            "minImageWidth": 200,
            "minImageHeight": 200,
            "urlNormalizer": { "stripHash": true, "stripQuery": true },
            "imageKeyPattern": { "match": "/media/[^/]+/(.+?)(?:\\.(?:jpg|jpeg|png|webp))$", "group": 1, "flags": "i" }
        }
    ],
    "security": { "settingsPasswordSet": false, "translatePasswordSet": false }
}
