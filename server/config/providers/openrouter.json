{
    "id": "openrouter",
    "kind": "provider",
    "name": "OpenRouter",
    "type": "openai-compatible",
    "settings": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "apiKeyEnv": "OPENROUTER_API_KEY",
        "defaultModel": "openai/gpt-5.4-nano",
        "responseFormat": {
            "type": "json_object"
        },
        "models": [
            {
                "id": "openai/gpt-5.4-nano",
                "label": "OpenAI-compatible default"
            }
        ]
    }
}
